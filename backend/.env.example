# OasisMadrid backend — variables de entorno

# Puerto del backend
PORT=3001

# Origen permitido para CORS (frontend)
FRONTEND_URL=http://localhost:5173

# AEMET — Agencia Estatal de Meteorología (avisos de calor)
# Registro gratuito: https://opendata.aemet.es/centrodedescargas/inicio
AEMET_API_KEY=

# OpenRouteService — motor base de rutas peatonales
# Registro gratuito (2.000 req/día): https://openrouteservice.org/dev/
ORS_API_KEY=

# Portal datos abiertos del Ayuntamiento de Madrid
MADRID_DATA_BASE_URL=https://datos.madrid.es/egob/catalogo
